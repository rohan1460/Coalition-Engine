# Razorpay (TEST MODE ONLY)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# Neo4j (affinity graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Anthropic (optional) — only used to generate customer-facing offer copy.
# If unset, the app falls back to deterministic template copy.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Payment safety bounds
MAX_TRANSACTION_INR=200000
OFFER_CONFIRMATION_TTL_SECONDS=300

# Set to true (with real rzp_test_ keys) to create REAL Razorpay test Orders.
# Leave false to use the built-in mock payment client (no network).
USE_REAL_RAZORPAY=false
# Set true only once the Route feature is activated on your account (KYC). Until
# then the split is simulated over a real order.
ROUTE_ENABLED=false
