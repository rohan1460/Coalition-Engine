# Environment
.env

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# Local databases / data files
*.db
*.sqlite
*.sqlite3
data/*.db
neo4j/

# Embedding cache is intentionally tracked (not ignored): shipping the
# precomputed vectors for the demo catalog means production never needs to
# import sentence-transformers/torch at all — critical on CPU-constrained
# free-tier hosting. Delete data/.embedding_cache.pkl locally and it
# regenerates automatically the next time you run with real compute.
